# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-ngrok-url.ngrok.io   # Public URL Twilio will call back to

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Deepgram (STT) ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ElevenLabs (TTS) ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Rahul voice
ELEVENLABS_VOICE_RAHUL=pNInz6obpgDQGcFmaJgB
# Priya voice
ELEVENLABS_VOICE_PRIYA=EXAVITQu4vr4xnSDxMaL
# Ansh voice
ELEVENLABS_VOICE_ANSH=VR6AewLTigWG4xSOukaG
# eleven_turbo_v2_5 = lowest latency
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Anthropic (LLM) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# claude-3-haiku-20240307 = lowest latency; use sonnet for better quality
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/voiceagent

# ── Email (nodemailer) ────────────────────────────────────────────────────────
CALENDAR_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_USER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_ADMIN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ── Session ───────────────────────────────────────────────────────────────────
# Minutes of silence before session is flushed to DB and wiped from RAM
SESSION_TIMEOUT_MINUTES=10
